# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Tauri/Rust
src-tauri/target
# The sidecars (the lock helper, the git guard), built by src-tauri/sidecars.
# The folder itself is kept, so the dev container's volume mounts onto it
# instead of creating it, owned by root, in the checkout.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# VS Code extension build output
vscode-extension/out
*.vsix

# Built installers — CI produces these, they don't belong in git
dist-linux
*.dmg
*.AppImage
*.deb
*.rpm
*.msi

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code: per-machine settings and scratch space, never part of the app
.claude/settings.local.json
.claude/scratch/
.claude/worktrees/
