{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitSwitch",
  "version": "0.1.0",
  "identifier": "com.gitswitch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitSwitch",
        "width": 900,
        "height": 650,
        "minWidth": 700,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFMTg4N0QwRDhEMjkxN0UKUldSK2tkTFkwSWNZL2pab0ZSbjIxemg3VnRUTTd6K0U1VGFROVBsNGRkMnpjWHRaaGxPdkVybmIK",
      "endpoints": [
        "https://github.com/Kshitijkb28/GitSwitch/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
