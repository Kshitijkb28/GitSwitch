# Cross-compiles the Windows installer (x86_64, NSIS) on a Linux host — a Mac
# running Docker included — without a Windows machine. cargo-xwin brings the
# Windows SDK and lld-link; NSIS builds the setup .exe Tauri's bundler asks
# for. The result lands in /out.
#
#   docker build -f scripts/docker/Dockerfile.windows -t gitswitch-win .
#   docker run --rm -v "$PWD/dist-windows:/out" gitswitch-win
FROM rust:1-bookworm

# libayatana-appindicator3: the Windows bundle never uses it, but Tauri's CLI
# looks for it on the HOST after every build (the tray feature's Linux check)
# and stops without it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang llvm lld nsis nsis-pluginapi curl ca-certificates file unzip \
    libayatana-appindicator3-dev \
 && rm -rf /var/lib/apt/lists/*

# Debian's nsis ships without the Win\*.nsh headers Tauri's installer script
# includes (RestartManager.nsh among them); the official NSIS release has
# them. Only those headers are taken from it.
RUN set -e; cd /tmp \
 && curl -fsSL -o nsis.zip https://sourceforge.net/projects/nsis/files/NSIS%203/3.11/nsis-3.11.zip/download \
 && mkdir -p nsis && cd nsis && unzip -q ../nsis.zip \
 && cp -r nsis-3.11/Include/Win /usr/share/nsis/Include/ \
 && ls /usr/share/nsis/Include/Win/RestartManager.nsh \
 && cd / && rm -rf /tmp/nsis /tmp/nsis.zip

# Node.js 20 (the Vite frontend build)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y nodejs \
 && rm -rf /var/lib/apt/lists/*

RUN rustup target add x86_64-pc-windows-msvc \
 && cargo install cargo-xwin --locked \
 && cargo install tauri-cli --version "^2" --locked

# The Windows SDK and CRT (from Microsoft's own CDN, under its EULA) — once,
# into the image, so each build does not re-download it.
RUN mkdir -p /xwin && cargo xwin --help >/dev/null 2>&1 || true
ENV XWIN_CACHE_DIR=/xwin \
    XWIN_ARCH=x86_64 \
    CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_RUSTFLAGS="-C target-feature=+crt-static"

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# The sidecars are built by Tauri's before-build (`cargo run -p
# gitswitch-sidecars`), which reads TAURI_ENV_TARGET_TRIPLE and builds them
# with the cargo GITSWITCH_CARGO_RUNNER names — cargo-xwin, which links with
# the Windows SDK's lld-link instead of looking for Microsoft's link.exe. The
# app itself is built the same way, through Tauri's `--runner`. The frontend
# is built first, on its own.
ENV TAURI_ENV_TARGET_TRIPLE=x86_64-pc-windows-msvc \
    GITSWITCH_CARGO_RUNNER=cargo-xwin
CMD ["bash", "-c", "set -e; npm run build; cargo tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis --config '{\"build\":{\"beforeBuildCommand\":\"cargo run --quiet --manifest-path src-tauri/Cargo.toml -p gitswitch-sidecars -- release\"}}'; mkdir -p /out; cp -v src-tauri/target/x86_64-pc-windows-msvc/release/bundle/nsis/*.exe /out/; echo 'Windows installer copied to ./dist-windows'"]
